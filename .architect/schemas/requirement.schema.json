{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openarchitect.local/schemas/requirement.schema.json",
  "title": "Open Architect Requirement Artifact",
  "allOf": [
    {
      "$ref": "./common-definitions.schema.json#/$defs/artifactDocument"
    },
    {
      "type": "object",
      "properties": {
        "spec": {
          "type": "object",
          "required": [
            "classification",
            "status",
            "ownership",
            "intent",
            "specification",
            "verification",
            "governance"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^REQ-\\d+$"
            },
            "classification": {
              "type": "object",
              "required": [
                "requirement_type",
                "category",
                "priority",
                "criticality"
              ],
              "properties": {
                "requirement_type": {
                  "type": "string",
                  "enum": [
                    "business",
                    "functional",
                    "non-functional",
                    "security",
                    "regulatory",
                    "operational"
                  ]
                },
                "category": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "string",
                  "enum": ["low", "medium", "high", "critical"]
                },
                "criticality": {
                  "$ref": "./common-definitions.schema.json#/$defs/criticality"
                }
              },
              "additionalProperties": true
            },
            "status": {
              "type": "object",
              "required": [
                "lifecycle",
                "approval_status",
                "verification_status"
              ],
              "properties": {
                "lifecycle": {
                  "type": "string",
                  "enum": ["proposed", "active", "satisfied", "retired", "archived"]
                },
                "approval_status": {
                  "type": "string",
                  "enum": ["draft", "proposed", "approved", "rejected", "superseded"]
                },
                "verification_status": {
                  "type": "string",
                  "enum": ["not-planned", "planned", "in-progress", "verified", "failed"]
                }
              },
              "additionalProperties": true
            },
            "ownership": {
              "type": "object",
              "required": [
                "business_owner",
                "requirement_owner",
                "verification_owner"
              ],
              "properties": {
                "business_owner": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement_owner": {
                  "type": "string",
                  "minLength": 1
                },
                "verification_owner": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "intent": {
              "type": "object",
              "required": ["statement"],
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "success_measure": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "target"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            },
            "specification": {
              "type": "object",
              "required": ["fit_criteria"],
              "properties": {
                "fit_criteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            },
            "verification": {
              "type": "object",
              "required": ["verification_method", "acceptance_owner"],
              "properties": {
                "verification_method": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "acceptance_owner": {
                  "type": "string",
                  "minLength": 1
                },
                "target_verification_date": {
                  "$ref": "./common-definitions.schema.json#/$defs/date"
                }
              },
              "additionalProperties": true
            },
            "governance": {
              "type": "object",
              "required": ["source_priority"],
              "properties": {
                "source_priority": {
                  "$ref": "./common-definitions.schema.json#/$defs/sourcePriority"
                },
                "waiver_process": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      }
    }
    ,
    {
      "if": {
        "properties": {
          "spec": {
            "properties": {
              "status": {
                "properties": {
                  "approval_status": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "properties": {
              "metadata": {
                "properties": {
                  "confidence": {
                    "enum": ["medium", "high"]
                  },
                  "references": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "spec": {
            "properties": {
              "status": {
                "properties": {
                  "verification_status": {
                    "const": "verified"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "properties": {
              "verification": {
                "required": ["target_verification_date"]
              },
              "metadata": {
                "properties": {
                  "references": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
