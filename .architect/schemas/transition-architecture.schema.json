{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openarchitect.local/schemas/transition-architecture.schema.json",
  "title": "Open Architect Transition Architecture Artifact",
  "allOf": [
    {
      "$ref": "./common-definitions.schema.json#/$defs/artifactDocument"
    },
    {
      "type": "object",
      "properties": {
        "spec": {
          "type": "object",
          "required": [
            "classification",
            "status",
            "ownership",
            "timeframe",
            "baseline",
            "target",
            "changes",
            "dependencies",
            "outcomes",
            "exit_criteria",
            "governance"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^TA-\\d+$"
            },
            "classification": {
              "type": "object",
              "required": ["architecture_state", "transition_type", "scope", "criticality"],
              "properties": {
                "architecture_state": {
                  "type": "string",
                  "enum": ["baseline", "transition", "target"]
                },
                "criticality": {
                  "$ref": "./common-definitions.schema.json#/$defs/criticality"
                }
              },
              "additionalProperties": true
            },
            "status": {
              "type": "object",
              "required": ["lifecycle", "planning_status", "delivery_status"],
              "properties": {
                "lifecycle": {
                  "type": "string",
                  "enum": ["planned", "in-flight", "completed", "retired", "archived"]
                },
                "planning_status": {
                  "type": "string",
                  "enum": ["draft", "proposed", "approved", "rejected", "superseded"]
                },
                "delivery_status": {
                  "type": "string",
                  "enum": ["green", "amber", "red", "complete", "on-hold"]
                }
              },
              "additionalProperties": true
            },
            "ownership": {
              "type": "object",
              "required": ["architecture_owner", "delivery_owner", "business_owner"],
              "additionalProperties": true
            },
            "timeframe": {
              "type": "object",
              "required": ["valid_from", "valid_to"],
              "properties": {
                "valid_from": {
                  "$ref": "./common-definitions.schema.json#/$defs/date"
                },
                "valid_to": {
                  "$ref": "./common-definitions.schema.json#/$defs/date"
                }
              },
              "additionalProperties": true
            },
            "baseline": {
              "type": "object",
              "required": ["reference_state", "architecture_scope"],
              "additionalProperties": true
            },
            "target": {
              "type": "object",
              "required": ["reference_state", "architecture_scope"],
              "additionalProperties": true
            },
            "changes": {
              "type": "object",
              "properties": {
                "introduced": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "id", "change_type"],
                    "properties": {
                      "change_type": {
                        "type": "string",
                        "enum": ["introduce", "modify", "retain", "retire"]
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "modified": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "id", "change_type"],
                    "properties": {
                      "change_type": {
                        "type": "string",
                        "enum": ["introduce", "modify", "retain", "retire"]
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "retained": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "id", "change_type"],
                    "properties": {
                      "change_type": {
                        "type": "string",
                        "enum": ["introduce", "modify", "retain", "retire"]
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "retired": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "id", "change_type"],
                    "properties": {
                      "change_type": {
                        "type": "string",
                        "enum": ["introduce", "modify", "retain", "retire"]
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            },
            "dependencies": {
              "type": "object",
              "additionalProperties": true
            },
            "outcomes": {
              "type": "object",
              "additionalProperties": true
            },
            "exit_criteria": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "governance": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      }
    }
    ,
    {
      "if": {
        "properties": {
          "spec": {
            "properties": {
              "status": {
                "properties": {
                  "planning_status": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "properties": {
              "metadata": {
                "properties": {
                  "references": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
