{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openarchitect.local/schemas/objective.schema.json",
  "title": "Open Architect Objective Artifact",
  "allOf": [
    {
      "$ref": "./common-definitions.schema.json#/$defs/artifactDocument"
    },
    {
      "type": "object",
      "properties": {
        "spec": {
          "type": "object",
          "required": [
            "classification",
            "status",
            "ownership",
            "intent",
            "scope",
            "governance"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^OBJ-\\d+$"
            },
            "classification": {
              "type": "object",
              "required": ["objective_type", "scope", "time_horizon", "criticality"],
              "properties": {
                "criticality": {
                  "$ref": "./common-definitions.schema.json#/$defs/criticality"
                }
              },
              "additionalProperties": true
            },
            "status": {
              "type": "object",
              "required": ["lifecycle", "approval_status", "progress_status"],
              "properties": {
                "lifecycle": {
                  "type": "string",
                  "enum": ["proposed", "active", "achieved", "retired", "archived"]
                },
                "approval_status": {
                  "type": "string",
                  "enum": ["draft", "proposed", "approved", "rejected", "superseded"]
                },
                "progress_status": {
                  "type": "string",
                  "enum": ["not-started", "in-progress", "at-risk", "achieved", "blocked"]
                }
              },
              "additionalProperties": true
            },
            "ownership": {
              "type": "object",
              "required": ["objective_owner", "architecture_owner", "measurement_owner"],
              "additionalProperties": true
            },
            "intent": {
              "type": "object",
              "required": ["statement"],
              "additionalProperties": true
            },
            "scope": {
              "type": "object",
              "additionalProperties": true
            },
            "governance": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      }
    }
    ,
    {
      "if": {
        "properties": {
          "spec": {
            "properties": {
              "status": {
                "properties": {
                  "approval_status": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "properties": {
              "metadata": {
                "properties": {
                  "references": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
