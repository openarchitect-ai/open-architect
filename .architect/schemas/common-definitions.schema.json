{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openarchitect.local/schemas/common-definitions.schema.json",
  "title": "Open Architect Common Definitions",
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "relationshipStrength": {
      "type": "string",
      "enum": ["primary", "supporting", "informational"]
    },
    "sourcePriority": {
      "type": "string",
      "enum": ["informational", "preferred", "authoritative"]
    },
    "criticality": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical", "mission-critical"]
    },
    "reference": {
      "type": "object",
      "required": ["type", "title", "url"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(https?://|\\.architect/).+"
        }
      },
      "additionalProperties": true
    },
    "changeLogEntry": {
      "type": "object",
      "required": ["date", "summary", "author"],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "sourceOfTruth": {
      "type": "object",
      "required": ["system", "record_locator", "owner"],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "record_locator": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": [
        "source_of_truth",
        "last_reviewed",
        "review_owner",
        "confidence",
        "references",
        "change_log"
      ],
      "properties": {
        "source_of_truth": {
          "$ref": "#/$defs/sourceOfTruth"
        },
        "last_reviewed": {
          "$ref": "#/$defs/date"
        },
        "review_owner": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "change_log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/changeLogEntry"
          }
        }
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": ["type", "target_kind", "target_id", "strength", "confidence"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "$ref": "#/$defs/relationshipStrength"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      },
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "object",
      "properties": {
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "artifactDocument": {
      "type": "object",
      "required": ["spec"],
      "properties": {
        "spec": {
          "type": "object",
          "required": [
            "id",
            "name",
            "display_name",
            "aliases",
            "summary",
            "description",
            "metadata",
            "relationships"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "aliases": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "metadata": {
              "$ref": "#/$defs/metadata"
            },
            "relationships": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relationship"
              }
            },
            "tags": {
              "$ref": "#/$defs/tags"
            },
            "notes": {
              "$ref": "#/$defs/notes"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
